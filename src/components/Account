import { useEffect, useState } from "react"
import { Navigate } from "react-router-dom"

import {
  collection,
  getDocs,
  query,
  where
} from "firebase/firestore"

import {
  signOut
} from "firebase/auth"

import {
  db,
  auth
} from "../firebase/config"

export default function Account() {

  const [tickets, setTickets] = useState([])
  const [loading, setLoading] = useState(true)

  const user = auth.currentUser

  useEffect(() => {

    async function loadTickets() {

      if (!user) {
        setLoading(false)
        return
      }

      try {

        const q = query(
          collection(db, "tickets"),
          where(
            "email",
            "==",
            user.email
          )
        )

        const snapshot =
          await getDocs(q)

        const data = []

        snapshot.forEach(doc => {

          data.push({
            id: doc.id,
            ...doc.data()
          })

        })

        setTickets(data)

      } catch (error) {

        console.log(error)

      }

      setLoading(false)

    }

    loadTickets()

  }, [user])

  async function logout() {

    await signOut(auth)

    window.location.href = "/login"

  }

  if (!user) {

    return (
      <Navigate to="/login" />
    )

  }

  return (

    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(to bottom,#000,#111)",
        color: "white",
        padding: "30px"
      }}
    >

      <div
        style={{
          maxWidth: "1100px",
          margin: "0 auto"
        }}
      >

        <div
          style={{
            background: "#111",
            padding: "25px",
            borderRadius: "20px",
            border: "1px solid red",
            marginBottom: "30px"
          }}
        >

          <h1
            style={{
              color: "red"
            }}
          >
            MY ACCOUNT
          </h1>

          <p>
            Logged in as:
          </p>

          <h3>
            {user.email}
          </h3>

          <p>
            Total Tickets:
            {" "}
            {tickets.length}
          </p>

          <div
            style={{
              display: "flex",
              gap: "10px",
              flexWrap: "wrap",
              marginTop: "20px"
            }}
          >

            <a
              href="mailto:muhlurigift129@gmail.com"
              style={buttonStyle}
            >
              CONTACT MGS
            </a>

            <button
              onClick={logout}
              style={buttonStyle}
            >
              LOGOUT
            </button>

          </div>

        </div>

        <h2
          style={{
            color: "red",
            marginBottom: "20px"
          }}
        >
          MY TICKETS
        </h2>

        {loading ? (

          <h3>
            Loading Tickets...
          </h3>

        ) : tickets.length === 0 ? (

          <div
            style={{
              background: "#111",
              padding: "25px",
              borderRadius: "15px"
            }}
          >
            No tickets found.
          </div>

        ) : (

          tickets.map(ticket => (

            <div
              key={ticket.id}
              style={{
                background: "#111",
                border: "1px solid red",
                borderRadius: "20px",
                padding: "25px",
                marginBottom: "25px"
              }}
            >

              <h2
                style={{
                  color: "red"
                }}
              >
                {ticket.packageName}
              </h2>

              <p>
                Ticket ID:
                {" "}
                {ticket.id}
              </p>

              <p>
                Quantity:
                {" "}
                {ticket.quantity}
              </p>

              <p>
                Total:
                {" "}
                R{ticket.total}
              </p>

              <p>
                Status:
                {" "}
                <span
                  style={{
                    color:
                      ticket.used
                        ? "orange"
                        : "lime"
                  }}
                >
                  {ticket.used
                    ? "USED"
                    : "VALID"}
                </span>
              </p>

              {ticket.qrCode && (

                <div
                  style={{
                    marginTop: "20px",
                    textAlign: "center"
                  }}
                >

                  <img
                    src={ticket.qrCode}
                    alt="QR Code"
                    width="220"
                  />

                  <br />

                  <a
                    href={ticket.qrCode}
                    download={`ticket-${ticket.id}.png`}
                    style={{
                      color: "red",
                      display: "inline-block",
                      marginTop: "15px"
                    }}
                  >
                    Download QR Code
                  </a>

                </div>

              )}

            </div>

          ))

        )}

      </div>

    </div>

  )

}

const buttonStyle = {

  background: "red",
  color: "white",
  border: "none",
  padding: "12px 20px",
  borderRadius: "10px",
  textDecoration: "none",
  cursor: "pointer",
  fontWeight: "bold"

}
